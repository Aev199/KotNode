 (kn:line b (- x (* h 1.6)) (+ y (* sign h 0.75)) x (+ y (* sign h 0.75)) "KNOT_Annotations")
 (kn:arrow b x (+ y (* sign h 0.75)) (- x h) (+ y (* sign h 0.75)) h)
 (kn:text b (- x (* h 1.5)) (+ y (* sign h 1.8)) h (itoa number)))
;; One pair of physical longitudinal weld edges for every plate.
;; Each item: (plate-index side Ax Ay Bx By Cx Cy outer-edge-y visible).
(defun kn:plate-welds (p / result j theta side a r ri ro half shift ax ay bx by cx cy beta cstep row)
 (setq result nil j 0 r (/ (nth 0 p) 2.0) ro (/ (nth 4 p) 2.0) ri (- ro (nth 3 p)) half (* pi (/ (nth 14 p) 360.0))
  shift (+ (- (* ri (cos half))) (sqrt (max 0.0 (- (* r r) (* ri ri (sin half) (sin half)))))))
 (repeat (fix (nth 13 p))
  (setq theta (* j (/ (* 2.0 pi) (nth 13 p))))
  (foreach side '(-1 1)
   (setq a (+ theta (* side half)) ax (+ (* shift (cos theta)) (* ri (cos a))) ay (+ (* shift (sin theta)) (* ri (sin a)))
    bx (+ (* shift (cos theta)) (* ro (cos a))) by (+ (* shift (sin theta)) (* ro (sin a)))
    beta (atan ay ax) cstep (/ (nth 6 p) r) cx (* r (cos (+ beta (* side cstep)))) cy (* r (sin (+ beta (* side cstep))))
    row (+ by (* side 0.7 (nth 6 p) (/ ax r))))
   (setq result (append result (list (list j side ax ay bx by cx cy row (if (>= ax -0.00000001) 1 0))))))
  (setq j (1+ j))) result)
;; Project physical welds onto the actual rectangular silhouettes of plates.
;; Each row is (edge-y visible outward-direction); katet is not a row offset.
(defun kn:weld-rows (p / rows edge sectors ys lo hi mid anchor direction found item out)
 (setq rows nil sectors (kn:sectors p))
 (foreach edge (kn:plate-welds p)
  (setq ys (mapcar 'cadr (nth (car edge) sectors)) lo (apply 'min ys) hi (apply 'max ys)
   mid (/ (+ (nth 3 edge) (nth 5 edge)) 2.0)
   direction (if (<= (abs (- mid lo)) (abs (- mid hi))) -1 1)
   anchor (if (= direction -1) lo hi) found nil out nil)
  (foreach item rows
   (if (and (< (abs (- (car item) anchor)) 0.000001) (= (nth 2 item) direction))
    (progn (setq out (append out (list (list anchor (max (cadr item) (nth 9 edge)) direction)))) (setq found T))
    (setq out (append out (list item)))))
  (if (not found) (setq out (append out (list (list anchor (nth 9 edge) direction)))))
  (setq rows out))
 (vl-sort rows '(lambda (a b) (> (car a) (car b)))))
(defun kn:weld-radius (row rows h len / radius other gap)
 (setq radius (min (* h 0.12) (/ len 4.0)))
 (foreach other rows
  (setq gap (* (nth 2 row) (- (car other) (car row))))
  (if (> gap 0.000001) (setq radius (min radius (* gap 0.22))))) radius)
(defun kn:weld-centre (row rows h len)
 (+ (car row) (* (nth 2 row) (kn:weld-radius row rows h len))))
(defun kn:cross (b x y radius layer)
 (kn:line b (- x radius) (- y radius) (+ x radius) (+ y radius) layer)
 (kn:line b (- x radius) (+ y radius) (+ x radius) (- y radius) layer))
(defun kn:draw-welds-main (b p h / rows row n i xx yy radius layer sec ys side j theta lo hi)
 (setq rows (kn:weld-rows p))
 (foreach row rows
  (setq radius (kn:weld-radius row rows h (nth 2 p))
   yy (kn:weld-centre row rows h (nth 2 p))
   layer (if (= (cadr row) 1) "KNOT_Welds" "KNOT_Hidden") i 0
   n (max 1 (min 500 (fix (/ (nth 2 p) (* radius 4.0))))))
  (repeat n
   (setq xx (+ (- (/ (nth 2 p) 2.0)) (* (nth 2 p) (/ (+ i 0.5) n))))
   ;; Weld symbols are always continuous, including symbols for rear plates.
   (kn:cross b xx yy radius "KNOT_Welds")
   (setq i (1+ i))))
 (if (= (nth 8 p) 1)
  (progn (setq j 0)
   (foreach sec (kn:sectors p)
    (setq theta (* j (/ (* 2.0 pi) (nth 13 p))))
    (if (>= (cos theta) -0.00000001)
     (progn
      (setq ys (mapcar 'cadr sec) lo (apply 'min ys) hi (apply 'max ys)
       radius (min (* h 0.12) (/ (- hi lo) 4.0)) i 0
       n (max 1 (min 500 (fix (/ (- hi lo) (* radius 4.0))))))
      (repeat n
       (setq yy (+ lo (* (- hi lo) (/ (+ i 0.5) n))))
       (foreach side '(-1 1)
        (setq xx (* side (+ (/ (nth 2 p) 2.0) radius)))
        (kn:cross b xx yy radius "KNOT_Welds"))
       (setq i (1+ i)))))
    (setq j (1+ j))))))
(defun kn:draw-welds-section (b p / edge)
 (foreach edge (kn:plate-welds p)
  (kn:styled (vla-AddSolid b (kn:p3 (nth 2 edge) (nth 3 edge)) (kn:p3 (nth 4 edge) (nth 5 edge)) (kn:p3 (nth 6 edge) (nth 7 edge)) (kn:p3 (nth 6 edge) (nth 7 edge))) "KNOT_Welds")))
(defun kn:leader-defs (p / h r len tail endx ro ri half shift rows upper lower edge weldtext defs)
 (setq h (* 2.5 (nth 18 p)) r (/ (nth 0 p) 2.0) len (nth 2 p) tail (max 160.0 (* (nth 0 p) 0.36)) endx (+ (/ len 2.0) tail)
  ro (/ (nth 4 p) 2.0) ri (- ro (nth 3 p)) half (* pi (/ (nth 14 p) 360.0)) shift (+ (- (* ri (cos half))) (sqrt (max 0.0 (- (* r r) (* ri ri (sin half) (sin half)))))))
 (setq rows (vl-remove-if '(lambda (v) (= (cadr v) 0)) (kn:weld-rows p)))
 (setq upper (if rows (kn:weld-centre (car rows) rows h len) r) lower (if (> (length rows) 1) (kn:weld-centre (cadr rows) rows h len) upper))
 (setq weldtext (strcat "Н1 {\\fArial|b0|i0;\\U+25B3}" (kn:fmt (nth 6 p)) "\\PГОСТ 5264-80*"))
 (setq defs (list
  (list "weld-main" "main" (list (list (* len -0.43) upper 0.0) (list (* len -0.32) (if (> lower 0) lower upper) 0.0)) (list (- (- (/ len 2.0)) (* h 8)) (+ r (* h 3)) 0.0) weldtext)
  (list "pipe-main" "main" (list (list (- (- (/ len 2.0)) (* tail 0.25)) (- r) 0.0)) (list (- (- (/ len 2.0)) (* tail 0.7) (* h 7)) (- (+ r (* h 3))) 0.0) (strcat "Труба %%c" (rtos (nth 0 p) 2 0) "x" (kn:fmt (nth 1 p))))
  (list "position" "section" (list (list (+ ro shift) 0.0 0.0)) (list (+ ro shift (* h 4)) (* r 0.28) 0.0) (itoa (fix (nth 15 p))))))
 ;; A section callout points at an actual weld on the upper/left side.
 (setq edge (car (vl-sort (kn:plate-welds p) '(lambda (a b) (> (- (nth 3 a) (nth 2 a)) (- (nth 3 b) (nth 2 b)))))))
 (setq defs (append defs (list (list "weld-section" "section" (list (list (nth 2 edge) (nth 3 edge) 0.0)) (list (- (+ r (* h 7))) (+ r (* h 3)) 0.0) weldtext))))
 (if (= (nth 7 p) 1) (setq defs (append defs (list (list "butt" "main" (list (list 0.0 r 0.0)) (list (* h 5) (+ r (* h 4)) 0.0) (strcat "С8 k=" (kn:fmt (nth 6 p)) "\\PГОСТ 16037-80")))))) defs)
