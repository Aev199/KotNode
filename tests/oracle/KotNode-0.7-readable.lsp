 (if (= units 0) (setq units (getvar "INSUNITSDEFTARGET")))
 (kn:put-if b 'Units units) (kn:nonannotative b) b)
(defun kn:refresh-geometry (doc definitions / i b obj)
 (setq i 0)
 (repeat 4
  (setq b (vla-Item (vla-get-Blocks doc) (nth i definitions)))
  (vlax-for obj b (vla-Update obj))
  (setq i (1+ i))))
;; Explicit continuous primitives avoid CANNOSCALE/MSLTSCALE/PSLTSCALE
;; reinterpreting dash lengths inside versus outside the block editor.
(defun kn:styled (obj layer / weight)
 (setq layer (strcat "KNOT2_" (substr layer 6)))
 (vla-put-Layer obj layer)
 (setq weight (cond ((member layer '("KNOT2_Profile" "KNOT2_Details")) 35) ((= layer "KNOT2_Axes") 13) (T 18)))
 (vla-put-Lineweight obj weight) (vla-put-Color obj 7)
 (vla-put-Linetype obj "CONTINUOUS") (vla-put-LinetypeScale obj 1.0) obj)
(defun kn:pattern-line (b x1 y1 x2 y2 layer / h pattern length1 dx dy distance1 index step until1 result)
 (setq h kn:dash-h dx (- x2 x1) dy (- y2 y1) length1 (sqrt (+ (* dx dx) (* dy dy)))
  pattern (if (= layer "KNOT_Axes") (list (* h 3.2) (- (* h 0.48)) (* h 0.32) (- (* h 0.48))) (list (* h 0.96) (- (* h 0.48))))
  distance1 0.0 index 0 result nil)
 (if (> length1 0.000001)
  (while (< distance1 (- length1 0.000001))
   (setq step (nth index pattern) until1 (min length1 (+ distance1 (abs step))))
   (if (> step 0)
    (setq result (kn:styled (vla-AddLine b
     (kn:p3 (+ x1 (* dx (/ distance1 length1))) (+ y1 (* dy (/ distance1 length1))))
     (kn:p3 (+ x1 (* dx (/ until1 length1))) (+ y1 (* dy (/ until1 length1))))) layer)))
   (setq distance1 until1 index (rem (1+ index) (length pattern))))) result)
(defun kn:line (b x1 y1 x2 y2 layer)
 (if (member layer '("KNOT_Hidden" "KNOT_Axes")) (kn:pattern-line b x1 y1 x2 y2 layer)
  (kn:styled (vla-AddLine b (kn:p3 x1 y1) (kn:p3 x2 y2)) layer)))
(defun kn:rect (b x1 y1 x2 y2 layer)
 (if (= layer "KNOT_Hidden")
  (progn (kn:line b x1 y1 x2 y1 layer) (kn:line b x2 y1 x2 y2 layer)
   (kn:line b x2 y2 x1 y2 layer) (kn:line b x1 y2 x1 y1 layer))
  (kn:poly b (list (list x1 y1) (list x2 y1) (list x2 y2) (list x1 y2)) layer)))
