(defun kn:xdata (p) (list -3 (list kn:app (cons 1000 "3") (cons 1000 (vl-prin1-to-string p)))))
(defun kn:legacy-read (e / x raw p)
 (if (setq x (assoc -3 (entget e (list kn:app))))
  (progn (setq raw (cdr (nth 2 (cadr x))) p (vl-catch-all-apply 'read (list raw)))
   (if (and (not (vl-catch-all-error-p p)) (listp p))
    (progn (setq p (kn:migrate p)) (if (not (kn:valid p)) p))))))
(defun kn:capture (/ p key str value)
  (setq p nil) (foreach key '("D" "t" "L" "s" "Db" "gap" "k") (setq str (get_tile key) value (distof str 2)) (setq p (append p (list value))))
  (setq p (append p (list (atoi (get_tile "butt")) (atoi (get_tile "fronts")) (distof (get_tile "count") 2) (atoi (get_tile "grade")) (atoi (get_tile "linkDb")) (atoi (get_tile "linkS")) (distof (get_tile "plateCount") 2) kn:angle-cache (distof (get_tile "position") 2) (distof (get_tile "section") 2) (distof (get_tile "spacing") 2) (distof (get_tile "annoScale") 2))))
  (if (and (nth 0 p) (nth 1 p)) (setq p (kn:normalize p))) p)
(defun kn:live (/ p msg)
 (mode_tile "gap" (if (= "1" (get_tile "butt")) 1 0))
 (if (= "1" (get_tile "butt")) (set_tile "gap" "0"))
 (mode_tile "spacing" (if (= 1 (atoi (get_tile "plateCount"))) 1 0))
 (if (= 1 (atoi (get_tile "plateCount"))) (set_tile "spacing" "0"))
  (mode_tile "s" (if (= "1" (get_tile "linkS")) 1 0)) (mode_tile "Db" (if (= "1" (get_tile "linkDb")) 1 0))
  (if (= "1" (get_tile "linkS")) (set_tile "s" (get_tile "t"))) (if (= "1" (get_tile "linkDb")) (set_tile "Db" (get_tile "D")))
  (setq p (kn:capture) msg (kn:valid p))
 (if (and (numberp (nth 14 p)) (> (nth 14 p) 0)) (setq kn:angle-cache (nth 14 p)))
 (set_tile "angleResult" (if (and (numberp (nth 14 p)) (> (nth 14 p) 0)) (strcat "Расчетный угол накладки: " (rtos (nth 14 p) 2 2) " град.") "Расчетный угол недоступен: проверьте параметры."))
 (set_tile "message" (if msg msg (strcat "Одна накладка: " (kn:n (kn:mass p)) " кг   /   Всего: " (kn:n (* (nth 13 p) (nth 9 p) (kn:mass p))) " кг"))))
