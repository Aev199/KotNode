    (kn:styled (vla-AddSolid b (kn:p3 x y) (kn:p3 (+ x (* h ux) (* h 0.22 (- uy))) (+ y (* h uy) (* h 0.22 ux))) (kn:p3 (+ x (* h ux) (* h 0.22 uy)) (+ y (* h uy) (* h 0.22 (- ux)))) (kn:p3 (+ x (* h ux) (* h 0.22 uy)) (+ y (* h uy) (* h 0.22 (- ux))))) "KNOT_Annotations"))))
