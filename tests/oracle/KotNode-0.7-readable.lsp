(defun kn:table (b x y rows widths h values / obj row col width line)
  (setq obj (vla-AddTable b (kn:p3 x y) rows (length widths) (* h 2.5) (* h 10.0)))
  (kn:styled obj "KNOT_Annotations") (kn:put-if obj 'TitleSuppressed :vlax-false) (kn:put-if obj 'HeaderSuppressed :vlax-false) (vla-put-RegenerateTableSuppressed obj :vlax-true)
  (vla-SetTextHeight obj 7 h) (vla-SetTextStyle obj 7 "KNOT_ISOCPEUR") (vla-put-HorzCellMargin obj (* h 0.45)) (vla-put-VertCellMargin obj (* h 0.4))
  (setq col 0) (foreach width widths (vla-SetColumnWidth obj col width) (setq col (1+ col)))
  (setq row 0) (foreach line values (setq col 0) (foreach value line (vla-SetText obj row col value) (setq col (1+ col))) (setq row (1+ row)))
  (if (= rows 5) (progn (vla-SetRowHeight obj 1 (* h 3.5)) (vla-SetRowHeight obj 3 (* h 4.0)))) (vla-put-RegenerateTableSuppressed obj :vlax-false) (vla-Update obj) obj)
