(defun kn:seam-levels (p / sectors j intervals sec ys theta merged item previous out levels last-hi)
 (setq sectors (kn:sectors p) j 0 intervals nil)
 (foreach sec sectors
  (setq theta (* j (/ (* 2.0 pi) (nth 13 p))))
  (if (>= (cos theta) -0.00000001) (progn (setq ys (mapcar 'cadr sec)) (setq intervals (cons (list (apply 'min ys) (apply 'max ys)) intervals))))
  (setq j (1+ j)))
 (setq intervals (vl-sort intervals '(lambda (a b) (< (car a) (car b)))) merged nil)
 (foreach item intervals
  (if (and merged (<= (car item) (+ (cadr (car merged)) 0.000001)))
   (setq merged (cons (list (car (car merged)) (max (cadr item) (cadr (car merged)))) (cdr merged)))
   (setq merged (cons item merged))))
 (setq merged (reverse merged) levels nil last-hi nil)
 (foreach item merged
  (if last-hi (setq levels (append levels (list (/ (+ last-hi (car item)) 2.0)))))
  (setq last-hi (cadr item)))
 (if (and (not levels) merged) (setq levels (list (car (car merged)) (cadr (car (last merged)))))) levels)
