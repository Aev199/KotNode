;;; KotNode 0.7 -- pipe splice prototype for full AutoCAD 2021 / Windows.
;;; ASCII source works with both legacy and Unicode AutoLISP engines.
;;; Units: millimetres. APPLOAD, then KNOTNEW / KNOTEDIT / KNOTINFO.
;;; Geometry is illustrative. No strength or weld resistance calculation.
(vl-load-com)
(setq kn:app "KOTNODE_V1")
;;; D t L s Db gap k butt fronts node-count grade-index link-Db link-s plate-count computed-angle position section spacing-mm
(setq kn:defaults '(820.0 8.0 950.0 8.0 820.0 10.0 9.0 0 1 13 0 1 1 4 84.0 4 4 50.0 20.0))
(defun kn:n (v) (rtos v 2 2))
(defun kn:fmt (v / value)
 (setq value (rtos v 2 2))
 (if (vl-string-search "." value) (setq value (vl-string-right-trim "." (vl-string-right-trim "0" value)))) value)
(defun kn:p3 (x y) (vlax-3d-point (list x y 0.0)))
(defun kn:spacing-at (p deg / r ri ro half q shift rr)
 (if (< (nth 13 p) 2) 0.0
  (progn (setq r (/ (nth 0 p) 2.0) ro (/ (nth 4 p) 2.0) ri (- ro (nth 3 p)) half (* pi (/ deg 360.0)) q (/ pi (nth 13 p))
   shift (+ (- (* ri (cos half))) (sqrt (max 0.0 (- (* r r) (* ri ri (sin half) (sin half)))))) rr (if (<= half q) ri ro))
   (* 2.0 (+ (* shift (sin q)) (* rr (sin (- q half))))))))
(defun kn:angle-for-spacing (p / lo hi mid target lower upper)
 (setq target (nth 17 p) lower (max 0.0 (kn:spacing-at p 180.0)) upper (kn:spacing-at p 0.0))
 (if (and (>= target (- lower 0.00000001)) (< target (- upper 0.00000001)))
  (progn (setq lo 0.0 hi 180.0)
   (repeat 72 (setq mid (/ (+ lo hi) 2.0)) (if (> (kn:spacing-at p mid) target) (setq lo mid) (setq hi mid)))
   (/ (+ lo hi) 2.0)) nil))
(defun kn:normalize (p / angle)
 (if (= 1 (nth 12 p)) (setq p (kn:replace 3 (nth 1 p) p)))
 (if (= 1 (nth 11 p)) (setq p (kn:replace 4 (nth 0 p) p)))
 (if (= 1 (nth 7 p)) (setq p (kn:replace 5 0.0 p)))
 (if (= (nth 13 p) 1) (setq p (kn:replace 17 0.0 p))
  (progn (setq angle nil)
   (if (and (vl-every 'numberp (list (nth 0 p) (nth 3 p) (nth 4 p) (nth 13 p) (nth 17 p)))
     (> (nth 0 p) 0) (> (nth 3 p) 0) (> (nth 4 p) (* 2.0 (nth 3 p)))
     (<= (- (nth 4 p) (* 2.0 (nth 3 p))) (+ (nth 0 p) 0.00000001))
     (>= (nth 13 p) 2) (<= (nth 13 p) 12) (= (nth 13 p) (fix (nth 13 p))))
    (setq angle (kn:angle-for-spacing p)))
   (setq p (kn:replace 14 (if angle angle 0.0) p)))) p)
(defun kn:migrate (p)
 (if (and (listp p) (member (length p) '(13 17 18 19)) (vl-every 'numberp p))
  (progn
   (if (= (length p) 13) (setq p (append p (list 4 (if (= (nth 7 p) 1) 60.0 90.0) 1 1))))
   (if (= (length p) 17) (setq p (append p (list (if (> (nth 13 p) 1) (kn:spacing-at p (nth 14 p)) 0.0)))))
   (if (= (length p) 18) (setq p (append p (list 20.0))))
   (kn:normalize p)) p))
(defun kn:spacing-dim (b p sectionx h / angle half q pitch r ri ro shift rr ax ay bx by obj)
 (if (and (> (nth 13 p) 1) (> (nth 17 p) 0.000001))
  (progn (setq angle (* pi (/ (nth 14 p) 180.0)) half (/ angle 2.0) q (/ pi (nth 13 p)) pitch (* 2.0 q) r (/ (nth 0 p) 2.0) ro (/ (nth 4 p) 2.0) ri (- ro (nth 3 p))
   shift (+ (- (* ri (cos half))) (sqrt (max 0.0 (- (* r r) (* ri ri (sin half) (sin half)))))) rr (if (<= half q) ri ro)
   ax (+ sectionx shift (* rr (cos half))) ay (* rr (sin half))
   bx (+ sectionx (* shift (cos pitch)) (* rr (cos (- pitch half)))) by (+ (* shift (sin pitch)) (* rr (sin (- pitch half)))))
   (setq obj (kn:dim b ax ay bx by (+ (/ (+ ax bx) 2.0) (* h 6.5 (cos q))) (+ (/ (+ ay by) 2.0) (* h 6.5 (sin q))) h "c=<>"))
   (kn:put-if obj 'PrimaryUnitsPrecision 1))))
(defun kn:replace (i value items / n) (setq n -1) (mapcar '(lambda (v) (setq n (1+ n)) (if (= n i) value v)) items))
(defun kn:valid (p / d t1 len s db gap k n)
  (if (and (listp p) (= 19 (length p)) (vl-every 'numberp p))
    (progn
      (setq d (nth 0 p) t1 (nth 1 p) len (nth 2 p) s (nth 3 p) db (nth 4 p) gap (nth 5 p) k (nth 6 p) n (nth 9 p))
      (cond ((or (< d 50) (> d 3000)) "Диаметр D должен быть от 50 до 3000 мм.")
        ((or (<= t1 0) (>= (* 2 t1) d)) "Требуется 0 < t < D/2.")
        ((or (<= db 0) (<= s 0) (>= (* 2 s) db)) "Требуется 0 < s < Dз/2.")
        ((> (- db (* 2 s)) (+ d 0.000001)) "Внутренний диаметр заготовки не должен превышать D в этой модели.")
        ((or (< len 20) (> len 10000)) "Длина накладки должна быть от 20 до 10000 мм.")
        ((or (< gap 0) (>= gap len)) "Требуется 0 <= зазор < L.")
        ((or (<= k 0) (> k 100)) "Требуется 0 < катет <= 100 мм.")
        ((or (< n 1) (> n 9999) (/= n (fix n))) "Число узлов: целое от 1 до 9999.")
        ((not (and (member (nth 7 p) '(0 1)) (member (nth 8 p) '(0 1)) (member (nth 11 p) '(0 1)) (member (nth 12 p) '(0 1)))) "Некорректное значение переключателя.")
        ((not (member (nth 10 p) '(0 1 2 3))) "Некорректная марка стали.")
        ((or (< (nth 13 p) 1) (> (nth 13 p) 12) (/= (nth 13 p) (fix (nth 13 p)))) "Число накладок: целое от 1 до 12.")
        ((or (<= (nth 14 p) 0) (> (nth 14 p) 180)) (strcat "Для этой заготовки расстояние должно быть от " (kn:n (max 0.0 (kn:spacing-at p 180.0))) " до " (kn:n (kn:spacing-at p 0.0)) " мм (верхняя граница не включается)."))
        ((< (nth 17 p) 0) "Расстояние между накладками не может быть отрицательным.")
        ((or (< (nth 15 p) 1) (> (nth 15 p) 999) (/= (nth 15 p) (fix (nth 15 p))) (< (nth 16 p) 1) (> (nth 16 p) 999) (/= (nth 16 p) (fix (nth 16 p)))) "Позиция и сечение: целое от 1 до 999.")
        ((or (< (nth 18 p) 1) (> (nth 18 p) 1000)) "Масштаб оформления: от 1 до 1000.")
        (T nil))) "Некорректная запись параметров."))
(defun kn:mass (p / angle ro ri) (setq angle (* pi (/ (nth 14 p) 180.0)) ro (/ (nth 4 p) 2.0) ri (- ro (nth 3 p))) (* 0.7 angle (- (* ro ro) (* ri ri)) (nth 2 p) 0.00000785))
(defun kn:sectors (p / angle half r ri ro shift sectors j theta points i a)
  (setq angle (* pi (/ (nth 14 p) 180.0)) half (/ angle 2.0) r (/ (nth 0 p) 2.0) ro (/ (nth 4 p) 2.0) ri (- ro (nth 3 p)) shift (+ (- (* ri (cos half))) (sqrt (- (* r r) (* ri ri (sin half) (sin half))))) sectors nil j 0)
  (repeat (fix (nth 13 p)) (setq theta (* j (/ (* 2.0 pi) (nth 13 p))) points nil i 0)
    (repeat 33 (setq a (+ theta (- half) (* angle (/ i 32.0)))) (setq points (append points (list (list (+ (* shift (cos theta)) (* ro (cos a))) (+ (* shift (sin theta)) (* ro (sin a)))))) i (1+ i)))
    (setq i 32) (repeat 33 (setq a (+ theta (- half) (* angle (/ i 32.0)))) (setq points (append points (list (list (+ (* shift (cos theta)) (* ri (cos a))) (+ (* shift (sin theta)) (* ri (sin a)))))) i (1- i)))
    (setq sectors (append sectors (list points)) j (1+ j))) sectors)
(defun kn:layer (doc name color / layers obj)
  (setq name (strcat "KNOT2_" (substr name 6)) layers (vla-get-Layers doc))
  (if (not (tblsearch "LAYER" name)) (progn (setq obj (vla-Add layers name)) (vla-put-Color obj color))))
(defun kn:nonannotative (obj / e)
 (setq e (vlax-vla-object->ename obj)) (regapp "AcadAnnotative")
 (if (not (entmod (append (entget e)
  (list '(-3 ("AcadAnnotative" (1000 . "AnnotativeData") (1002 . "{") (1070 . 1) (1070 . 0) (1002 . "}")))))))
  (kn:fail "Не удалось отключить аннотативность компонента узла")) obj)
