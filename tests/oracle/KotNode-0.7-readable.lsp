(defun kn:fail (message) (princ (strcat "\nKotNode: " message)) (exit))
;; Persistent assembly links. The self handle deliberately rejects plain COPY
;; duplicates: editing one must never silently edit its source assembly.
(defun kn:chunks (s / out)
 (setq out nil)
 (while (> (strlen s) 230)
  (setq out (append out (list (substr s 1 230))) s (substr s 231)))
 (append out (list s)))
(defun kn:record (e id role p / data piece)
 (regapp kn:app)
 (setq data (list kn:app (cons 1000 "5") (cons 1000 id) (cons 1000 role) (cons 1000 (cdr (assoc 5 (entget e))))))
 (if p (foreach piece (kn:chunks (vl-prin1-to-string p)) (setq data (append data (list (cons 1000 piece))))))
 (if (not (entmod (append (entget e) (list (list -3 data))))) (kn:fail "Не удалось записать связь компонентов узла"))
 (entupd e) e)
(defun kn:record-read (e / x vals)
 (if (and e (setq x (assoc -3 (entget e (list kn:app)))))
  (progn
   (setq vals (mapcar 'cdr (cdr (cadr x))))
   (if (and (>= (length vals) 4) (= (nth 0 vals) "5") (= (nth 3 vals) (cdr (assoc 5 (entget e)))))
    (list (nth 1 vals) (nth 2 vals) (if (> (length vals) 4) (apply 'strcat (cddddr vals)) ""))))))
(defun kn:resolve (e / rec root rr p version)
 (if (setq rec (kn:record-read e))
  (progn
   (setq root (handent (car rec)) rr (kn:record-read root))
   (if (and rr (= (cadr rr) "main") (= (car rr) (cdr (assoc 5 (entget root)))))
    (progn
     (setq p (vl-catch-all-apply 'read (list (nth 2 rr))))
     (if (and (not (vl-catch-all-error-p p)) (listp p) (not (kn:valid p))) (list root p)))))
  (progn
   (setq version (assoc -3 (entget e (list kn:app))))
   ;; Version 5 with mismatched self handle is an unlinked COPY, not legacy.
   (if (and version (/= (cdr (nth 1 (cadr version))) "5") (= (cdr (assoc 0 (entget e))) "INSERT")) (setq p (kn:legacy-read e)))
   (if p (list e p)))))
(defun kn:parts (root / id ss i e rec result)
 (setq id (cdr (assoc 5 (entget root))) result (list (cons "main" root)))
 (if (setq ss (ssget "_X" (list (list -3 (list kn:app)))))
  (progn (setq i 0)
   (repeat (sslength ss)
    (setq e (ssname ss i) rec (kn:record-read e) i (1+ i))
    (if (and rec (= (car rec) id) (/= (cadr rec) "main"))
     (if (assoc (cadr rec) result) (kn:fail "Найдены дубли компонентов узла") (setq result (cons (cons (cadr rec) e) result))))))) result)
(defun kn:array (v)
 (if (= (type v) 'VARIANT) (setq v (vlax-variant-value v)))
 (if (= (type v) 'SAFEARRAY) (vlax-safearray->list v) v))
(defun kn:doubles (values / arr)
 (setq arr (vlax-make-safearray vlax-vbDouble (cons 0 (1- (length values)))))
 (vlax-safearray-fill arr values) arr)
(defun kn:vertices (points) (kn:doubles (apply 'append points)))
(defun kn:world (ref pt / ip a xx yy)
 (setq ip (kn:array (vla-get-InsertionPoint ref)) a (vla-get-Rotation ref)
  xx (* (car pt) (vla-get-XScaleFactor ref)) yy (* (cadr pt) (vla-get-YScaleFactor ref)))
 (list (+ (car ip) (* xx (cos a)) (- (* yy (sin a)))) (+ (cadr ip) (* xx (sin a)) (* yy (cos a))) (+ (caddr ip) (* (caddr pt) (vla-get-ZScaleFactor ref)))))
(defun kn:insert-part (space main name local / obj)
 (setq obj (vla-InsertBlock space (vlax-3d-point (kn:world main local)) name (vla-get-XScaleFactor main) (vla-get-YScaleFactor main) (vla-get-ZScaleFactor main) (vla-get-Rotation main)))
 (vlax-vla-object->ename obj))
(defun kn:replace-definition (e name / data)
 (setq data (entget e))
 (if (/= (cdr (assoc 0 data)) "INSERT") (kn:fail "Вместо вида выбран объект другого типа"))
 (if (not (entmod (subst (cons 2 name) (assoc 2 data) data))) (kn:fail "Не удалось обновить вид"))
 (entupd e) e)
(defun kn:leader-style (obj p)
 (kn:styled obj "KNOT_Annotations")
 (kn:put-if obj 'ContentType 2) (kn:put-if obj 'LeaderType 1)
 (kn:put-if obj 'ScaleFactor (nth 18 p))
 (kn:put-if obj 'ArrowheadType 0) (kn:put-if obj 'ArrowheadSize 1.8)
 (kn:put-if obj 'TextStyleName "KNOT_ISOCPEUR") (kn:put-if obj 'TextHeight 2.5))
(defun kn:ensure-mleader-style (doc / dict st)
 (setq kn:ml-style-name nil dict (vla-Item (vla-get-Dictionaries doc) "ACAD_MLEADERSTYLE"))
 (vlax-for st dict
  (if (and (not kn:ml-style-name) (= (vla-get-Annotative st) :vlax-false))
   (setq kn:ml-style-name (vla-get-Name st))))
 (if (not kn:ml-style-name) (kn:fail "В чертеже нет неаннотативного стиля мультивыносок. Создайте его через МВЫНОСКАСТИЛЬ.")))
(defun kn:make-leader (space points / old result)
 (setq old (getvar "CMLEADERSTYLE"))
 (setvar "CMLEADERSTYLE" kn:ml-style-name)
 (setq result (vl-catch-all-apply 'vla-AddMLeader (list space (kn:vertices points) 0)))
 (setvar "CMLEADERSTYLE" old)
 (if (vl-catch-all-error-p result) (kn:fail (vl-catch-all-error-message result))) result)
(defun kn:leader-update (space e tips landing text p / obj indexes i verts lineidx point)
 (if e
  (progn (setq obj (vlax-ename->vla-object e))
   (if (/= (vla-get-ObjectName obj) "AcDbMLeader") (kn:fail "Неверный тип выноски")))
  (progn
   (setq obj (kn:make-leader space (list (car tips) landing)))
   (kn:put-if obj 'DogLegged :vlax-true) (kn:put-if obj 'DoglegLength 3.0) (kn:put-if obj 'LandingGap 0.7) (kn:put-if obj 'TextWidth (* 30.0 (nth 18 p)))
   (setq e (vlax-vla-object->ename obj))))
 (kn:leader-style obj p)
 (kn:put-if obj 'TextString text)
 (setq indexes (kn:array (vla-GetLeaderLineIndexes obj 0)) i 0)
 (foreach point tips
  (if (< i (length indexes))
   (progn
    (setq lineidx (nth i indexes) verts (kn:array (vla-GetLeaderLineVertices obj lineidx)))
    (if (< (length verts) 6) (kn:fail "Повреждена линия выноски"))
    ;; Only the arrow tip changes. User-moved bends/landing stay intact.
    (vla-SetLeaderLineVertices obj lineidx (kn:doubles (append point (cdddr verts)))))
   (progn
    (setq verts (kn:array (vla-GetLeaderLineVertices obj (car indexes))))
    (vla-AddLeaderLine obj 0 (kn:doubles (append point (cdddr verts))))))
  (setq i (1+ i)))
 (vla-Update obj) e)
;; Native dimensions belong to the drawing space, not a nested block.
;; AutoCAD 2021 can retain pre-override *D graphics for nested dimensions.
(defun kn:remember-dim (b obj / role)
 (setq role (if (wcmatch (strcase (vla-get-Name b)) "*_SECTION") "section" "main"))
 (setq kn:pending-dims (append kn:pending-dims (list (list role obj)))) obj)
(defun kn:object-array (objects / arr)
 (setq arr (vlax-make-safearray vlax-vbObject (cons 0 (1- (length objects)))))
 (vlax-safearray-fill arr objects) arr)
(defun kn:ref-matrix (ref / ip angle1 sx sy sz)
 (setq ip (kn:array (vla-get-InsertionPoint ref)) angle1 (vla-get-Rotation ref)
  sx (vla-get-XScaleFactor ref) sy (vla-get-YScaleFactor ref) sz (vla-get-ZScaleFactor ref))
 (vlax-tmatrix (list
  (list (* sx (cos angle1)) (- (* sy (sin angle1))) 0.0 (car ip))
  (list (* sx (sin angle1)) (* sy (cos angle1)) 0.0 (cadr ip))
  (list 0.0 0.0 sz (caddr ip)) '(0.0 0.0 0.0 1.0))))
(defun kn:place-dimensions (root p parts pending / item obj parent e id role i j scale1)
 (setq id (cdr (assoc 5 (entget root))) i 0 j 0)
 ;; Old dimensions are regenerated from parameters, as they were inside blocks.
 (foreach item parts
  (if (wcmatch (car item) "dim-main-*,dim-section-*") (entdel (cdr item))))
 (foreach item pending
  (setq role (car item) obj (cadr item) parent (vlax-ename->vla-object (cdr (assoc role parts)))
   scale1 (abs (vla-get-XScaleFactor parent)))
  (vla-TransformBy obj (kn:ref-matrix parent))
  (kn:put-if obj 'ScaleFactor (* (nth 18 p) scale1))
  (kn:put-if obj 'LinearScaleFactor (/ 1.0 scale1))
  (setq e (vlax-vla-object->ename obj))
  (if (= role "main") (setq i (1+ i) role (strcat "dim-main-" (itoa i)))
   (setq j (1+ j) role (strcat "dim-section-" (itoa j))))
  (kn:record e id role nil) (vla-Update obj)))
(defun kn:group-node (doc root / groups parts role objects item name group1)
 (setq groups (vla-get-Groups doc) parts (kn:parts root))
 (foreach role '("main" "section")
  (setq objects nil)
  (foreach item parts
   (if (or (= (car item) role) (wcmatch (car item) (strcat "dim-" role "-*")))
    (setq objects (append objects (list (vlax-ename->vla-object (cdr item)))))))
  (setq name (strcat "KNOT_" (cdr (assoc 5 (entget root))) "_" role)
   group1 (vl-catch-all-apply 'vla-Item (list groups name)))
  (if (not (vl-catch-all-error-p group1)) (vla-Delete group1))
  (setq group1 (vla-Add groups name))
  (vla-AppendItems group1 (kn:object-array objects))))
(defun kn:rebuild (doc root p point / definitions space main parts role name e id loc def parent tips landing old kn:dimension-space kn:pending-dims)
 (kn:ensure-mleader-style doc)
 (setq kn:dimension-space (if root (vlax-ename->vla-object (cdr (assoc 330 (entget root)))))
  kn:pending-dims nil)
 (if (not kn:dimension-space) (setq kn:dimension-space (if (= (getvar "CVPORT") 1) (vla-get-PaperSpace doc) (vla-get-ModelSpace doc))))
 (setq definitions (kn:build-parts doc p))
 (if root
  (progn
   (setq parts (kn:parts root) space (vlax-ename->vla-object (cdr (assoc 330 (entget root)))))
   (kn:replace-definition root (car definitions)))
  (progn
   (setq space (if (= (getvar "CVPORT") 1) (vla-get-PaperSpace doc) (vla-get-ModelSpace doc)))
   (setq main (vla-InsertBlock space (vlax-3d-point point) (car definitions) 1.0 1.0 1.0 0.0)
    root (vlax-vla-object->ename main) parts (list (cons "main" root)))))
 (setq main (vlax-ename->vla-object root) id (cdr (assoc 5 (entget root))))
 (kn:record root id "main" p)
 (foreach role '("section" "spec" "vrs")
  (setq name (nth (cond ((= role "section") 1) ((= role "spec") 2) (T 3)) definitions)
   e (cdr (assoc role parts)) loc (cadr (assoc role (nth 4 definitions))))
  (if e (kn:replace-definition e name)
   (progn (setq e (kn:insert-part space main name loc)) (setq parts (cons (cons role e) parts))))
  (kn:record e id role nil))
 (foreach def (nth 5 definitions)
  (setq role (car def) parent (vlax-ename->vla-object (cdr (assoc (nth 1 def) parts))) tips nil)
  (foreach loc (nth 2 def) (setq tips (append tips (list (kn:world parent loc)))))
  (setq landing (kn:world parent (nth 3 def)) e (kn:leader-update space (cdr (assoc role parts)) tips landing (nth 4 def) p))
  (kn:record e id role nil))
 (if (and (= (nth 7 p) 0) (setq old (cdr (assoc "butt" parts)))) (entdel old))
 (kn:place-dimensions root p parts kn:pending-dims)
 (kn:group-node doc root)
 (kn:refresh-geometry doc definitions)
 root)
(defun kn:select (/ e pair)
 (setq e (car (entsel "\nВыберите вид, размер, таблицу или выноску узла: ")))
 (if e
  (progn (setq pair (kn:resolve e))
   (if (not pair) (princ "\nСвязь с узлом не найдена. Для независимой копии используйте KNOTCOPY; взорванные блоки не поддерживаются.")))) pair)
(defun kn:command (mode / *error* doc undo pair root p point)
 (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) undo nil)
 (defun *error* (message)
  (if undo (progn (vla-EndUndoMark doc) (setq undo nil)))
  (if message (princ (strcat "\nKotNode: " message ". При неполном результате используйте ОТМЕНИТЬ."))) (princ))
 (if (= mode "new") (setq p kn:defaults)
  (if (setq pair (kn:select)) (setq root (car pair) p (cadr pair))))
 (if (and p (or (= mode "update") (setq p (kn:dialog p))))
  (progn
   (setq point (if root '(0.0 0.0 0.0) (getpoint "\nУкажите точку вставки узла: ")))
   (if point
    (progn
     (vla-StartUndoMark doc) (setq undo T)
     (kn:rebuild doc root p (trans point 1 0))
     (setq kn:defaults p) (vla-Regen doc 1) (vla-EndUndoMark doc) (setq undo nil)
     (princ "\nУзел обновлен. Виды и таблицы: ПЕРЕНЕСТИ; выноски: ручки MLeader. После переноса вида — KNOTUPDATE."))))) (princ))
(defun c:KNOTNEW () (kn:command "new"))
(defun c:KNOTEDIT () (kn:command "edit"))
(defun c:KNOTUPDATE () (kn:command "update"))
(defun c:KNOTCOPY (/ *error* pair doc undo root parts p from to delta copies item obj e newroot id)
 (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) undo nil)
 (defun *error* (message)
  (if undo (vla-EndUndoMark doc))
  (if message (princ (strcat "\nKotNode: " message ". При неполном результате используйте ОТМЕНИТЬ."))) (princ))
 (if (and (setq pair (kn:select)) (setq from (getpoint "\nБазовая точка копирования: ")) (setq to (getpoint from "\nТочка размещения копии: ")))
  (progn
   (setq root (car pair) p (cadr pair))
   (vla-StartUndoMark doc) (setq undo T)
   ;; Migrate old composite nodes before copying linked components.
   (if (not (kn:record-read root)) (kn:rebuild doc root p '(0.0 0.0 0.0)))
   (setq parts (kn:parts root) delta (mapcar '- (trans to 1 0) (trans from 1 0)) copies nil)
   (foreach item parts
    (setq obj (vla-Copy (vlax-ename->vla-object (cdr item))))
    (vla-Move obj (vlax-3d-point '(0.0 0.0 0.0)) (vlax-3d-point delta))
    (setq copies (cons (cons (car item) (vlax-vla-object->ename obj)) copies)))
   (setq newroot (cdr (assoc "main" copies)) id (cdr (assoc 5 (entget newroot))))
   (foreach item copies (kn:record (cdr item) id (car item) (if (= (car item) "main") p nil)))
   (kn:group-node doc newroot)
   (vla-EndUndoMark doc) (setq undo nil) (vla-Regen doc 1)
   (princ "\nСоздана независимая копия узла с сохранением расстановки."))) (princ))
(defun c:KNOTINFO (/ pair p)
 (if (setq pair (kn:select))
  (progn (setq p (cadr pair))
   (princ (strcat "\nМасштаб оформления 1:" (kn:fmt (nth 18 p)) "; накладок на узел: " (itoa (fix (nth 13 p))) "; масса накладки: " (kn:n (kn:mass p)) " кг; суммарная масса: " (kn:n (* (nth 13 p) (nth 9 p) (kn:mass p))) " кг.")))) (princ))
(defun kn:dimension-cache (doc e / name block1 obj height style)
 (setq name (cdr (assoc 2 (entget e))))
 (if name
  (progn
   (setq block1 (vl-catch-all-apply 'vla-Item (list (vla-get-Blocks doc) name)))
   (if (not (vl-catch-all-error-p block1))
    (vlax-for obj block1
     (if (= (vla-get-ObjectName obj) "AcDbMText")
      (setq height (vla-get-Height obj) style (vla-get-StyleName obj)))))))
 (if height (list height style)))
(defun c:KNOTCHECK (/ pair doc parts p item role parent expected actual bad count1)
 (if (setq pair (kn:select))
  (progn
   (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) parts (kn:parts (car pair)) p (cadr pair) bad 0 count1 0)
   (vla-Regen doc 1)
   (foreach item parts
    (if (wcmatch (car item) "dim-main-*,dim-section-*")
     (progn
      (setq role (if (wcmatch (car item) "dim-main-*") "main" "section")
       parent (vlax-ename->vla-object (cdr (assoc role parts)))
       expected (* 2.5 (nth 18 p) (abs (vla-get-XScaleFactor parent)))
       actual (kn:dimension-cache doc (cdr item)) count1 (1+ count1))
      (princ (strcat "\n" (car item) ": ожидается " (kn:n expected) " мм; графика: "
       (if actual (strcat (kn:n (car actual)) " мм, " (cadr actual)) "нет сохраненной графики")))
      (if (or (not actual) (> (abs (- (car actual) expected)) 0.001) (/= (strcase (cadr actual)) "KNOT_ISOCPEUR")) (setq bad (1+ bad))))))
   (if (= count1 0)
    (princ "\nВнешние размеры не найдены. Сначала выполните KNOTUPDATE для перехода на 0.7.")
    (princ (strcat "\nПроверено размеров: " (itoa count1) "; несоответствий графики: " (itoa bad) "."))))) (princ))
(princ "\nУзел 0.7 загружен: KNOTNEW, KNOTEDIT, KNOTUPDATE, KNOTCOPY, KNOTINFO, KNOTCHECK.")
(princ)
